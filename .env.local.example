# ============================================================
# Revive Fight Club — Environment Variables Template
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file to .env.local
#   2. Fill in real values
#   3. NEVER commit .env.local to Git
#   4. .env.local is already excluded by .gitignore
# ============================================================

# ---- Supabase ----
# Found in: Supabase Dashboard > Project Settings > API
# Public (safe to expose — used in browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Private (server only — NEVER expose to browser)
# Used ONLY in: Server Components, Route Handlers, Server Actions, Edge Functions
SUPABASE_SERVICE_ROLE_KEY=

# ---- Application ----
# The base URL of the application (no trailing slash)
# Development: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Business Contact (populated in Phase 4) ----
# These are used for contact forms and notifications
# WHATSAPP_API_KEY=
# EMAIL_SERVICE_API_KEY=
# NOTIFICATION_EMAIL=

# ---- Analytics (populated in Phase 6) ----
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_GTM_ID=
