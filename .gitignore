# ============================================================
# Revive Fight Club — .gitignore
# ============================================================

# ---- Dependencies ----
node_modules/
.pnp
.pnp.js

# ---- Build Outputs ----
.next/
out/
build/
dist/

# ---- Agent ----
.gemini/

# ---- Environment Variables (NEVER COMMIT) ----
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# ---- Testing ----
coverage/
.nyc_output

# ---- IDE ----
.idea/
.vscode/settings.json
*.swp
*.swo

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- TypeScript ----
*.tsbuildinfo
next-env.d.ts

# ---- Logs ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ---- Supabase ----
supabase/.branches
supabase/.temp

# ---- Misc ----
.cache/
.turbo/
.vercel
