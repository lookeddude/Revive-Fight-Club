# ============================================================
# REVIVE FIGHT CLUB — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================

# Supabase — Public (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase — Server only
# NEVER prefix with NEXT_PUBLIC_
# NEVER commit real values to git
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Razorpay ─────────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com → Settings → API Keys
# Test mode keys start with rzp_test_
# Live mode keys start with rzp_live_

# Public key — safe to expose in browser (prefetch only)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Server-only keys — NEVER prefix with NEXT_PUBLIC_
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Webhook secret — from Razorpay Dashboard → Settings → Webhooks
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ── Email (Resend) ────────────────────────────────────────────
# Get from: https://resend.com → API Keys
# Free tier: 100 emails/day, 3000/month
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@revivefightclub.com
